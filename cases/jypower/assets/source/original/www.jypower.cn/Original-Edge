          const walk = (x - startX) * 3;
          container.scrollLeft = scrollLeft - walk;
        });
      
        container.addEventListener('mouseup', () => {
          isDragging = false;  
        });
      
        container.addEventListener('mouseleave', () => {
          isDragging = false;  
        });
</script>
<script type="text/javascript" src="/assets/addons/cms/frontend/js/jquery.dataTables.js"></script>
<script>
  $(function () {
    const CURRENTTAG = '14';
    if (CURRENTTAG == 13 || CURRENTTAG == 11 || CURRENTTAG == 14) {
      var tableId = '#productTable';

      // 若已初始化则销毁，避免重复绑定
      if ($.fn.dataTable.isDataTable(tableId)) {
        $(tableId).DataTable().destroy();
      }

      var table = $(tableId).DataTable({
        pageLength: 10,
        fixedHeader: true,
        responsive: true,
        ordering: false,  // 禁用排序功能
        paging: false, // 禁用分页
        info: false
        // 如为服务端分页，请开启并自行在 ajax.data 中提交列筛选参数
        // serverSide: true,
        // ajax: { url: '你的接口', data: function (d) { /* 追加列筛选值 */ } }
      });

      // 工具：清理文本（去 &nbsp;、合并空白、去两端空格）
      function cleanText(str) {
        return (str || '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
      }

      // 事件委托：表头内的 select/input 变化即筛选
      $(tableId + ' thead').on('change', 'select,input', function () {
        var $this = $(this);
        var colIdx = table.column($(this).closest('th')).index();
        var val = cleanText($this.val());

        // 文本包含匹配；如需精确匹配可改为：'^' + $.fn.dataTable.util.escapeRegex(val) + '$'
        table.column(colIdx).search(val, false, true).draw();
      });

      // 阻止点击筛选控件时触发表头排序
      $(tableId + ' thead').on('click', 'select,option,input', function (e) {
        e.stopPropagation();
      });

      // 构建表头筛选行：select 下拉
      table.columns().every(function (colIdx) {
        var column = this;
        var headerCell = $(column.header());

        // 跳过第一列，不添加筛选下拉框
        if (colIdx === 0) {
          return;
        }

        var select = $('<select><option value="">全部</option></select>')
                .appendTo(headerCell)
                .on('click', function (e) {
                  e.stopPropagation();
                });

        // 用渲染后的单元格文本收集唯一值（更贴近用户看到的文本）
        var unique = {};
        column.nodes().each(function (cell) {
          var txt = cleanText($(cell).text());
          if (txt && !unique[txt]) {
            unique[txt] = true;
            select.append($('<option></option>').val(txt).text(txt));
          }
        });
      });
    }
  });
</script>

